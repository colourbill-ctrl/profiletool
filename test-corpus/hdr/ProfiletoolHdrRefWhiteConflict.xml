<!--
  profiletool fixture: HAGC reference white vs metadataTag CRWL, DISAGREEING.

  THE ONE THING THIS PINS. Clause 8.10.4 states no precedence between the two
  carriers of the content HDR reference white, and states its 203 cd/m^2 default
  twice with conditions that disagree exactly where an HAGC tag is present. That
  is iccDEV register item HDR-10. icGetHdrProfileInfo()'s ruling is HAGC first,
  then CRWL, then 203 — on the grounds that the gain curve in that same tag was
  authored against that white, so dividing by the other would evaluate the curve
  at a white it was not built for.

  Nothing in iccDEV's 42-fixture corpus can distinguish those two orders. Only
  HagcDisplay and HdrLinearHagcWhite carry a HAGC reference white, and neither
  carries a CRWL entry; our own ProfiletoolHdrDisplay carries both but sets them
  EQUAL (203/203) so that H7 reports an agreement. profiletool's headroom checker
  shipped with the precedence INVERTED and still scored 84/84 against the whole
  corpus — which is how the gap was found.

  This fixture makes the two orders give different answers:

      HAGC HDRReferenceWhite = 300      CLL peak = 600
      metadataTag CRWL       = 203

      HAGC first (the ruling)  ->  600 / 300 = 2.0
      CRWL first (the bug)     ->  600 / 203 = 2.9557

  Transfer is LINEAR (cicp 8) and not PQ, deliberately: 8.10.4's content-headroom
  resolution is gated on Linear, because that is the only transfer the priority
  order is stated for. Under PQ the division never happens and the fixture would
  prove nothing.

  It also wakes PAWG H7's DISAGREE branch, which no fixture in either corpus
  reaches — ProfiletoolHdrDisplay reaches the agree branch, this one the other —
  and gives HDR-10 its first executable case.

  Still a conforming HDR Profile: 8.10.1 admits transfer 8 (Linear) alongside 16
  and 18, so changing PQ to Linear costs no membership. Every other attribute is
  unchanged from ProfiletoolHdrDisplay — single-attribute-delta, in the style the
  upstream corpus uses.

  REGISTRY CAVEAT (inherited): the ICC dictType Metadata Registry defining CRWL is
  unpublished, so that key is a reconstruction.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>mntr</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-09-10T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="true" UseWithEmbeddedDataOnly="true"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- BT.2020 primaries, chromatically adapted to D50. -->
    <redColorantTag> <XYZArrayType>
      <XYZNumber X="0.636962890625" Y="0.262695312500" Z="0.000000000000"/>
    </XYZArrayType> </redColorantTag>

    <greenColorantTag> <XYZArrayType>
      <XYZNumber X="0.144622802734" Y="0.677978515625" Z="0.028076171875"/>
    </XYZArrayType> </greenColorantTag>

    <blueColorantTag> <XYZArrayType>
      <XYZNumber X="0.168869018555" Y="0.059326171875" Z="1.060989379883"/>
    </XYZArrayType> </blueColorantTag>

    <!-- No redTRCTag/greenTRCTag/blueTRCTag: 8.10.1 prohibits them, and their
         absence is what distinguishes this fixture from every upstream one.
         The transfer function is carried by the cicpTag instead. -->

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="9" TransferCharacteristics="8" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <!-- 8.10.6 requires an AToB0Tag in EVERY RGB HDR Profile, whatever the
         profile class, as the fallback path for a consumer that implements no
         HDR processing at all; 8.10.3 c) requires it to be PAIRED with a
         BToA0Tag, which is the defect HdrMissingBToA0.icc isolates. Identity
         B-curve LUTs, exactly as HdrBakedLut.icc uses: what this fixture proves
         is that the pair is present and complete, not what it contains. -->
    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <!-- Same simple gain curve as ProfiletoolHdrDisplay — one alternate, fixed
         mixing type 2, PCHIP-derived slopes. HDRReferenceWhite is 300.0 here so
         it DISAGREES with the CRWL entry below; under the HAGC-first ruling this
         value is the one 8.10.4 divides by. -->
    <headroomAdaptiveGainCurveTag> <headroomAdaptiveGainCurveType>
      <HagcMetadata ApplicationVersion="1" MinApplicationVersion="1"
                    HDRReferenceWhite="300.0000"
                    BaselineHeadroom="2.0000" HeadroomAdaptiveToneMap="true"
                    ChromaticitiesMode="1" CommonComponentMixing="false" CommonCurveParameters="false">
       <AlternateImage Headroom="0.0000" ComponentMixingType="2" PchipSlope="true">
        <ControlPoints>
         <ControlPoint X="0.2500" Y="-0.05000"/>
         <ControlPoint X="0.5000" Y="-0.12000"/>
         <ControlPoint X="0.7500" Y="-0.20000"/>
         <ControlPoint X="1.0000" Y="-0.30000"/>
        </ControlPoints>
       </AlternateImage>
      </HagcMetadata>
    </headroomAdaptiveGainCurveType> </headroomAdaptiveGainCurveTag>

    <!-- CRWL deliberately DISAGREES with the HAGC tag's HDRReferenceWhite (300)
         above: that disagreement is the whole point of this fixture. CLL supplies
         the luminance 8.10.4 divides by the resolved white. DERH still gives H8 a
         subject on the display axis. -->
    <metaDataTag> <dictType>
      <DictEntry Name="CRWL" Value="203.0"/>
      <DictEntry Name="CLL" Value="600.0 300.0 9"/>
      <DictEntry Name="DERH" Value="2.0"/>
      <DictEntry Name="DRWL" Value="203.0"/>
      <DictEntry Name="DCV" Value="0.708 0.292 0.170 0.797 0.131 0.046 0.3127 0.3290 812.0 0.005"/>
    </dictType> </metaDataTag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[profiletool HDR Profile: HAGC reference white 300 vs CRWL 203 (Linear)]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 William Li. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
