<!--
  profiletool fixture: the TWO headroom axes divide by DIFFERENT reference whites.

  THE ONE THING THIS PINS. When a profile carries both carriers of the content HDR
  reference white, clause 8.10.4's content headroom and clause 8.10.5 c)'s display
  headroom are divided by different values of a quantity both clauses call CRWL:

    8.10.4 content headroom  divides by info.contentReferenceWhite, which is
                             resolved HAGC-first (the HDR-10 ruling), so 300 here.
    8.10.5 c) display headroom  calls CIccHdrMetadataReader::ResolveDisplayHeadroom(),
                             which uses GetResolvedContentReferenceWhite() =
                             `m_bHasCrwl ? m_crwl : 203` — blind to the HAGC tag,
                             so 203 here.

  With CLL and DCV both at 600 cd/m^2 this profile therefore reports:

      content headroom = 600 / 300 = 2.0
      display headroom = 600 / 203 = 2.9557

  Same numerator, same profile, one quantity, two answers.

  WHY IT HAPPENS, which is the part that suggests it was not intended. The display
  path lives inside CIccHdrMetadataReader, which reads only the metadataTag and
  structurally cannot see the HAGC tag at all. The content path is resolved one
  level up in icGetHdrProfileInfo(), where both carriers are visible. So the
  asymmetry follows from where each resolver sits, not from a decision that the
  two axes should differ — and the content-side comment's care ("the divisor is
  info.contentReferenceWhite, not the reader's own CRWL") reads like someone who
  noticed the distinction on one side only.

  NEITHER SIDE IS OBVIOUSLY WRONG, which is why this is a fixture and not a bug
  report. 8.10.5 c) says "CRWL is taken from the HDR Image metadata of 8.10.4",
  which names the ENTRY and would justify the reader's behaviour; the content side
  follows the HDR-10 ruling on the resolved QUANTITY. Whether those mean the same
  thing is a question for the maintainer and possibly the WG. This fixture exists
  so that whichever way it is resolved, the change is visible rather than silent.

  CONSTRUCTION. Derived from ProfiletoolHdrRefWhiteConflict by removing DERH and
  adding DCV: with no DERH and no DRWL, 8.10.5 falls through a) and b) to c),
  which is the only display rule that consults a reference white at all. Transfer
  stays LINEAR, because 8.10.4's content resolution is gated on it
  (IccHdrProfile.cpp: `info.nTransferCharacteristics == icCicpTransferLinear`) and
  under PQ or HLG the content axis would never be computed.

  REGISTRY CAVEAT (inherited): the ICC dictType Metadata Registry defining CRWL,
  DCV and CLL is unpublished, so those keys are reconstructions.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>mntr</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-09-10T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="true" UseWithEmbeddedDataOnly="true"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- BT.2020 primaries, chromatically adapted to D50. -->
    <redColorantTag> <XYZArrayType>
      <XYZNumber X="0.636962890625" Y="0.262695312500" Z="0.000000000000"/>
    </XYZArrayType> </redColorantTag>

    <greenColorantTag> <XYZArrayType>
      <XYZNumber X="0.144622802734" Y="0.677978515625" Z="0.028076171875"/>
    </XYZArrayType> </greenColorantTag>

    <blueColorantTag> <XYZArrayType>
      <XYZNumber X="0.168869018555" Y="0.059326171875" Z="1.060989379883"/>
    </XYZArrayType> </blueColorantTag>

    <!-- No redTRCTag/greenTRCTag/blueTRCTag: 8.10.1 prohibits them, and their
         absence is what distinguishes this fixture from every upstream one.
         The transfer function is carried by the cicpTag instead. -->

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="9" TransferCharacteristics="8" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <!-- 8.10.6 requires an AToB0Tag in EVERY RGB HDR Profile, whatever the
         profile class, as the fallback path for a consumer that implements no
         HDR processing at all; 8.10.3 c) requires it to be PAIRED with a
         BToA0Tag, which is the defect HdrMissingBToA0.icc isolates. Identity
         B-curve LUTs, exactly as HdrBakedLut.icc uses: what this fixture proves
         is that the pair is present and complete, not what it contains. -->
    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <!-- Same simple gain curve as ProfiletoolHdrDisplay — one alternate, fixed
         mixing type 2, PCHIP-derived slopes. HDRReferenceWhite is 300.0 here so
         it DISAGREES with the CRWL entry below; under the HAGC-first ruling this
         value is the one 8.10.4 divides by. -->
    <headroomAdaptiveGainCurveTag> <headroomAdaptiveGainCurveType>
      <HagcMetadata ApplicationVersion="1" MinApplicationVersion="1"
                    HDRReferenceWhite="300.0000"
                    BaselineHeadroom="2.0000" HeadroomAdaptiveToneMap="true"
                    ChromaticitiesMode="1" CommonComponentMixing="false" CommonCurveParameters="false">
       <AlternateImage Headroom="0.0000" ComponentMixingType="2" PchipSlope="true">
        <ControlPoints>
         <ControlPoint X="0.2500" Y="-0.05000"/>
         <ControlPoint X="0.5000" Y="-0.12000"/>
         <ControlPoint X="0.7500" Y="-0.20000"/>
         <ControlPoint X="1.0000" Y="-0.30000"/>
        </ControlPoints>
       </AlternateImage>
      </HagcMetadata>
    </headroomAdaptiveGainCurveType> </headroomAdaptiveGainCurveTag>

    <!-- No DERH and no DRWL, deliberately: that is what makes 8.10.5 fall through
         a) and b) to c), the only display rule that consults a reference white.
         CLL 600 feeds the content axis, DCV 600 the display axis — the same
         numerator on both, so the only thing that can make the two results differ
         is the divisor, which is exactly what this fixture is for. -->
    <metaDataTag> <dictType>
      <DictEntry Name="CRWL" Value="203.0"/>
      <DictEntry Name="CLL" Value="600.0 300.0 9"/>
      <DictEntry Name="DCV" Value="600.0 0.005 1"/>
    </dictType> </metaDataTag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[profiletool HDR Profile: content and display axes divide by different reference whites]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 William Li. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
